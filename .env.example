# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy Supabase projects may use this instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only integrations. Never prefix these with NEXT_PUBLIC or EXPO_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
ODDS_API_KEY=
SPORTSGAMEODDS_API_KEY=
NEWS_API_KEY=
SPORTSDATA_API_KEY=
SPORTSDATA_BASE_URL=https://api.sportsdata.io
LINEUP_API_URL=
LINEUP_API_KEY=
SPORTS_CONTEXT_API_URL=
SPORTS_CONTEXT_API_KEY=
OPENAI_API_KEY=

# Optional read-only Veikkaus bookmaker prices via the independent Odds-API.io feed.
# This key is used only server-side for price comparison. Scorecaster never logs in
# to Veikkaus, opens a betslip, stores payment data or places a real-money wager.
# If the key is absent or the provider fails, the primary The Odds API feed remains usable.
VEIKKAUS_ODDS_API_IO_KEY=

# Optional normalized xG, tracking, player and golf-shot provider.
# Scorecaster sends a bounded event contract with POST over HTTPS and expects
# { observations: [...], shots: [...] }. The API key is sent only in a Bearer header.
SPORTS_ANALYTICS_API_URL=
SPORTS_ANALYTICS_API_KEY=
SPORTS_ANALYTICS_PROVIDER_NAME=

# Optional rights-approved generic JSON collector source.
# Keep disabled until the provider contract and commercial/model-training rights are verified.
# The endpoint must use HTTPS and accept the Scorecaster Collector V1 POST contract.
COLLECTOR_JSON_API_URL=
COLLECTOR_JSON_API_KEY=
COLLECTOR_JSON_SOURCE_ID=configured_json_api
COLLECTOR_JSON_SOURCE_NAME=Configured JSON API
COLLECTOR_JSON_ENABLED=false
COLLECTOR_JSON_ACCESS_MODE=disabled
COLLECTOR_JSON_COMMERCIAL_ALLOWED=false
COLLECTOR_JSON_REDISTRIBUTION_ALLOWED=false
COLLECTOR_JSON_TRAINING_ALLOWED=false
COLLECTOR_JSON_ATTRIBUTION_REQUIRED=false
COLLECTOR_JSON_ATTRIBUTION=
COLLECTOR_JSON_LICENSE=unverified
COLLECTOR_JSON_TERMS_URL=
COLLECTOR_JSON_SPORTS=multi-sport

# Shared scheduler authentication for protected internal workers.
# Use one strong random value in Vercel and the matching GitHub Actions secret.
CRON_SECRET=

# Explicit server-side opt-in. Keep false until migration, RLS and worker probes pass.
SCORECASTER_SHADOW_LEARNING_ENABLED=false

# Optional JSON maps. Keep them server-only.
# Maps Scorecaster sport keys to SportsGameOdds league IDs.
SPORTSGAMEODDS_LEAGUE_MAP_JSON={}
# Maps normalized venue/home-team names to {"latitude":0,"longitude":0}.
VENUE_COORDINATES_JSON={}
# Maps news domains to trust values between 0 and 1.
NEWS_SOURCE_TRUST_JSON={}

# Dedicated random server secret for short-lived Agent decision tickets.
# Use at least 32 unpredictable characters and do not reuse another integration key.
AGENT_DECISION_SIGNING_KEY=

# Optional non-secret server setting for the grounded explanation model.
# The default is gpt-5-mini when this is left blank.
OPENAI_AGENT_MODEL=