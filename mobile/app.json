{
  "expo": {
    "name": "Scorecaster",
    "description": "Sports analysis, risk control and virtual paper tracking without real-money betting.",
    "slug": "scorecaster",
    "version": "0.2.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "scorecaster",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090f"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vvglitchhub.scorecaster",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.vvglitchhub.scorecaster",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07090f"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Scorecaster to protect your signed-in session."
        }
      ],
      [
        "expo-notifications",
        { "defaultChannel": "scorecaster-alerts" }
      ]
    ],
    "extra": {
      "productMode": "sports-analysis-and-paper-tracking",
      "realMoneyBetting": false,
      "authRedirectUrl": "scorecaster://auth/confirm"
    }
  }
}
