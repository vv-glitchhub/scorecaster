    { "path": "/api/internal/autonomous-agent", "method": "GET", "allowedStatuses": [401, 503] },
    { "path": "/api/internal/notification-delivery", "method": "GET", "allowedStatuses": [401, 503] },
    { "path": "/api/internal/decision-diagnostics", "method": "GET", "allowedStatuses": [401, 503] },
    { "path": "/api/internal/unified-data", "method": "GET", "allowedStatuses": [401, 503] }
  ],
  "requiredSecurityHeaders": {
    "x-content-type-options": "nosniff",
    "x-frame-options": "DENY",
    "referrer-policy": "no-referrer",
    "cross-origin-opener-policy": "same-origin",
    "cross-origin-resource-policy": "same-origin"
  },
  "supabaseMigrations": [
    "supabase/scorecaster_schema.sql",
    "supabase/scorecaster_auth_cloud.sql",
    "supabase/scorecaster_paper_risk_limits.sql",
    "supabase/scorecaster_api_rate_limits.sql",
