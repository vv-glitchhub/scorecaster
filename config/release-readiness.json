      "blocking": true
    },
    {
      "id": "unified-data-ai-provenance",
      "title": "AI data-used, data-not-used, bounded-impact, downgrade-only and closing-odds leakage controls verified on production fixtures",
      "blocking": true
    },
    {
      "id": "physical-push",
      "title": "Physical iOS and Android push delivery test",
      "blocking": true
    },
    {
      "id": "multilingual-device-flow",
      "title": "Authentication, paper save, settlement, export and deletion in FI, EN and ES",
      "blocking": true
    },
    {
      "id": "eas-project-and-assets",
      "title": "EAS project linkage, final icon, splash and signed builds",
      "blocking": true
    },
    {
      "id": "legal-support-identity",
      "title": "Final support contact, legal controller identity and store disclosures",
      "blocking": true
    },
    {
      "id": "external-security-review",
      "title": "Independent production security review",
      "blocking": true
    }
  ]
}
