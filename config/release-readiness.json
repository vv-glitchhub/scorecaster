{
  "version": 1,
  "product": "Scorecaster",
  "productionBaseUrl": "https://scorecaster.vercel.app",
  "productBoundary": "sports analysis, risk control and virtual paper tracking only",
  "publicPages": [
    "/",
    "/help",
    "/privacy",
    "/terms",
    "/responsible-use",
    "/production-status",
    "/autonomous-agent",
    "/polymarket-intelligence",
    "/diagnostics-v2",
    "/provider-health",
    "/data-layer"
  ],
  "protectedApis": [
    { "path": "/api/operations", "method": "GET", "allowedStatuses": [401, 403] },
    { "path": "/api/account", "method": "GET", "allowedStatuses": [401, 403] },
    { "path": "/api/account/export", "method": "GET", "allowedStatuses": [401, 403] },
    { "path": "/api/cloud/bets", "method": "GET", "allowedStatuses": [401, 403] },
    { "path": "/api/cloud/watchlist", "method": "GET", "allowedStatuses": [401, 403] },
    { "path": "/api/cloud/alerts", "method": "GET", "allowedStatuses": [401, 403] },
    { "path": "/api/cloud/notifications", "method": "GET", "allowedStatuses": [401, 403] },
    { "path": "/api/cloud/watchlist-monitor", "method": "GET", "allowedStatuses": [401, 403] },
    { "path": "/api/cloud/settlement-monitor", "method": "GET", "allowedStatuses": [401, 403] },
    { "path": "/api/cloud/autonomous-agent", "method": "GET", "allowedStatuses": [401, 403] },
    { "path": "/api/cloud/polymarket-intelligence", "method": "GET", "allowedStatuses": [401, 403] }
  ],
  "internalWorkers": [
    { "path": "/api/internal/watchlist-monitor", "method": "GET", "allowedStatuses": [401, 503] },
    { "path": "/api/internal/settlement-monitor", "method": "GET", "allowedStatuses": [401, 503] },
    { "path": "/api/internal/autonomous-agent", "method": "GET", "allowedStatuses": [401, 503] },
    { "path": "/api/internal/shadow-learning", "method": "GET", "allowedStatuses": [401, 503] },
    { "path": "/api/internal/notification-delivery", "method": "GET", "allowedStatuses": [401, 503] },
    { "path": "/api/internal/decision-diagnostics", "method": "GET", "allowedStatuses": [401, 503] },
    { "path": "/api/internal/unified-data", "method": "GET", "allowedStatuses": [401, 503] }
  ],
  "requiredSecurityHeaders": {
    "x-content-type-options": "nosniff",
    "x-frame-options": "DENY",
    "referrer-policy": "no-referrer",
    "cross-origin-opener-policy": "same-origin",
    "cross-origin-resource-policy": "same-origin"
  },
  "supabaseMigrations": [
    "supabase/scorecaster_schema.sql",
    "supabase/scorecaster_auth_cloud.sql",
    "supabase/scorecaster_paper_risk_limits.sql",
    "supabase/scorecaster_api_rate_limits.sql",
    "supabase/scorecaster_watchlist_alerts.sql",
    "supabase/scorecaster_market_timeline.sql",
    "supabase/scorecaster_alert_inbox.sql",
    "supabase/scorecaster_notification_registry.sql",
    "supabase/scorecaster_notification_delivery.sql",
    "supabase/scorecaster_watchlist_monitor.sql",
    "supabase/scorecaster_decision_diagnostics.sql",
    "supabase/scorecaster_unified_data.sql",
    "supabase/scorecaster_settlement_monitor.sql",
    "supabase/scorecaster_autonomous_agent.sql",
    "supabase/scorecaster_autonomous_agent_v2.sql",
    "supabase/scorecaster_shadow_learning_v1.sql"
  ],
  "mobileLocales": {
    "apple": ["fi", "en-US", "es-ES"],
    "googlePlay": ["fi-FI", "en-US", "es-ES"]
  },
